import java.io.*;
import java.util.*;

public class DAY27_Nested_Logic {

    public static void main(String[] args) {
        /* Enter your code here. Read input from STDIN. Print output to STDOUT. Your class should be named Solution. */
        Scanner sc=new Scanner(System.in);
        int D1=sc.nextInt();
        int M1=sc.nextInt();
        int Y1=sc.nextInt();
        
        int D2=sc.nextInt();
        int M2=sc.nextInt();
        int Y2=sc.nextInt();
        
        int fine=0;
        if(Y1>Y2)
        {
            fine=10000;
        }
        if(Y1==Y2)
        {
            if(M1>M2)
            {
                fine=500*(M1-M2);
            }
        }
         if(Y1==Y2)
        {
            if(M1==M2)
            {
                if(D1>D2)
                {
                    fine=15*(D1-D2);
                }
            }
        }
        System.out.print(fine);
        
    }
}
